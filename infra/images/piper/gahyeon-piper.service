[Unit]
Description=Gahyeon Piper TTS runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/zaeze-ai/gahyeon-piper/runtime
EnvironmentFile=/opt/zaeze-ai/gahyeon-piper/current.env
ExecStart=/opt/zaeze-ai/gahyeon-piper/venv/bin/python -m uvicorn server:app --host 127.0.0.1 --port 18767 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zaeze-ai/gahyeon-piper

[Install]
WantedBy=multi-user.target
