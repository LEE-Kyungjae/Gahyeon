# Electron main-process settings (shell environment, not Vite renderer values):
# GAHYEON_CORE_API_URL=http://127.0.0.1:8080/api
# GAHYEON_CLIENT_TOKEN=

# URL served to the renderer, for example /models/gahyeon.vrm
VITE_GAHYEON_VRM_URL=

# JSON object mapping activities to licensed .vrma URLs.
VITE_GAHYEON_VRMA_MANIFEST=

# Opt-in. Requires a connected display and Looking Glass Bridge.
VITE_GAHYEON_LOOKING_GLASS=false
