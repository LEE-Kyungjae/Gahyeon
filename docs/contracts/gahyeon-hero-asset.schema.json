{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gahyeon.local/schemas/gahyeon-hero-asset.schema.json",
  "title": "Gahyeon Hero Character Asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "characterId", "status", "qualityTier", "gate", "source", "packages", "semantics", "provenance", "acceptanceEvidence"],
  "properties": {
    "schemaVersion": {"const": 2},
    "characterId": {"const": "gahyeon"},
    "status": {"enum": ["draft", "candidate", "approved", "retired"]},
    "qualityTier": {"enum": ["hero-master", "desktop-performance", "looking-glass", "vrm-compatibility"]},
    "gate": {"enum": ["G1", "G2", "G3", "G4", "G5"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "coordinateSystem", "unitMeters"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "coordinateSystem": {"enum": ["y-up-right-handed", "z-up-right-handed", "z-up-left-handed"]},
        "unitMeters": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["renderer", "format", "uri", "sha256", "bytes", "lods", "materials", "groomMode"],
        "properties": {
          "renderer": {"enum": ["hero-engine", "three-vrm", "looking-glass"]},
          "format": {"enum": ["unreal-content-zip", "vrm", "glb"]},
          "uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "lods": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "materials": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "groomMode": {"enum": ["strands", "cards", "mesh", "none"]},
          "peakVramMiB": {"type": "integer", "minimum": 0},
          "targetFrameMs": {"type": "number", "exclusiveMinimum": 0}
        },
        "allOf": [
          {"if": {"properties": {"renderer": {"const": "hero-engine"}}}, "then": {"properties": {"format": {"const": "unreal-content-zip"}}}},
          {"if": {"properties": {"renderer": {"const": "three-vrm"}}}, "then": {"properties": {"format": {"const": "vrm"}}}},
          {"if": {"properties": {"renderer": {"const": "looking-glass"}}}, "then": {"properties": {"format": {"enum": ["vrm", "glb"]}}}}
        ]
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expressions", "visemes", "activities"],
      "properties": {
        "expressions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "visemes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "activities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "license", "sourceFiles", "sourceManifests", "createdAt"],
      "properties": {
        "author": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "sourceFiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sourceManifests": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "uri", "sha256"],
            "properties": {
              "kind": {"enum": ["identity-reference", "modeling-input"]},
              "uri": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "createdAt": {"type": "string", "format": "date-time"},
        "approvedAt": {"type": "string", "format": "date-time"},
        "approvedBy": {"type": "string", "minLength": 1}
      }
    },
    "acceptanceEvidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate", "uri", "sha256"],
        "properties": {
          "gate": {"enum": ["G1", "G2", "G3", "G4", "G5"]},
          "uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
    "then": {
      "properties": {
        "gate": {"const": "G5"},
        "provenance": {"required": ["author", "license", "sourceFiles", "sourceManifests", "createdAt", "approvedAt", "approvedBy"]},
        "acceptanceEvidence": {"minItems": 5}
      }
    }
  }]
}
